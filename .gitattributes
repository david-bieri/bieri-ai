# Normalize line endings across David's three machines (home/office/laptop).
# Text files are stored LF in the repo and checked out native; this stops the
# spurious "modified" churn on Windows checkouts.
* text=auto eol=lf

# Explicit: scripts and skill sources are always LF
*.py   text eol=lf
*.sh   text eol=lf
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf

# Binary assets — never normalize
*.png  binary
*.pdf  binary
*.svg  text eol=lf
*.ico  binary
