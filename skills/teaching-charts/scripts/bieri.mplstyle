# ============================================================================
# bieri.mplstyle — house style for teaching-charts (empirical figures)
# Matches the deck palette (C00000 / 262626 / 808080) and clean-spine look.
# Use:  import matplotlib.pyplot as plt; plt.style.use("bieri.mplstyle")
# Font: a serif close to the XCharter diagrams keeps figures and diagrams
#       visually unified. Falls back gracefully if XCharter isn't on the system.
# ============================================================================

# ---- font ----
# Palatino body to match the newpx diagrams; Heros/Arial sans for any titles.
font.family        : serif
font.serif         : TeX Gyre Pagella, Palatino, Palatino Linotype, Palladio, DejaVu Serif
font.sans-serif    : TeX Gyre Heros, Helvetica, Arial, DejaVu Sans
font.size          : 11
mathtext.fontset   : cm

# ---- color cycle (Supply-red first, then dark, gray, box) ----
axes.prop_cycle    : cycler('color', ['C00000', '262626', '808080', 'A6A6A6'])

# ---- spines: drop top + right (journal look) ----
axes.spines.top    : False
axes.spines.right  : False
axes.edgecolor     : 262626
axes.linewidth     : 0.9
axes.labelcolor    : 262626
axes.titlecolor    : 262626
axes.titlesize     : 12
axes.titleweight   : bold
axes.labelsize     : 11

# ---- ticks ----
xtick.color        : 333333
ytick.color        : 333333
xtick.labelsize    : 10
ytick.labelsize    : 10
xtick.direction    : out
ytick.direction    : out

# ---- grid: light horizontal only ----
axes.grid          : True
axes.grid.axis     : y
grid.color         : D9D9D9
grid.linewidth     : 0.7
grid.alpha         : 0.9

# ---- lines + markers ----
lines.linewidth    : 2.4
lines.markersize   : 5
lines.solid_capstyle: round

# ---- legend ----
legend.frameon     : False
legend.fontsize    : 9.5

# ---- figure: 16:9-friendly panel, white bg ----
figure.figsize     : 7.4, 3.2
figure.facecolor   : white
axes.facecolor     : white
savefig.facecolor  : white
savefig.dpi        : 200
savefig.bbox       : tight
